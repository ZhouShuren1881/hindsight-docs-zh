    },
    {
      "id": "pg",
      "type": "group",
      "label": {
        "title": "PostgreSQL"
      },
      "children": [
        "mem",
        "ops"
      ],
      "layout": {
        "direction": "column",
        "gap": 28,
        "align": "stretch"
