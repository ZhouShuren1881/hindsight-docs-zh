        }
      ]
    },
    {
      "id": "emb",
      "type": "rectangle",
      "content": [
        {
          "type": "title",
          "text": "嵌入模型与重排器"
        },
        {
          "type": "subtitle",
          "text": "本地或远程"
        }
      ]
    },
    {
      "id": "models",
      "type": "group",
      "label": {
        "title": "模型提供商"
      },
      "children": [
        "llm",
        "emb"
      ],
      "layout": {
        "direction": "column",
        "gap": 16,
        "align": "stretch"
      }
    },
    {
      "id": "g2",
      "type": "group",
      "children": [
        "workers",
        "models"
      ],
      "layout": {
        "direction": "column",
        "gap": 36,
        "align": "stretch"
      }
    },
    {
      "id": "g0",
      "type": "group",
      "children": [
        "g1",
        "api",
        "pg",
        "g2"
      ],
      "layout": {
        "direction": "row",
        "gap": 48,
        "align": "center"
      }
    },
    {
      "id": "app-http",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "app"
      },
      "end": {
        "id": "http"
      },
      "label": {
        "text": "请求"
      }
    },
    {
      "id": "cp-http",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "cp"
      },
      "end": {
        "id": "http"
      },
      "label": {
        "text": "SDK"
      }
    },
    {
      "id": "http-mem",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "http"
      },
      "end": {
        "id": "mem"
      }
    },
    {
      "id": "http-ops",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "http"
      },
      "end": {
        "id": "ops"
      },
      "label": {
        "text": "入队"
      }
    },
    {
      "id": "http-emb",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "http"
      },
      "end": {
        "id": "models"
      },
      "quiet": true
    },
    {
      "id": "claim-iw",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "ops"
      },
      "end": {
        "id": "iworker"
      },
      "label": {
        "text": "领取"
      },
      "quiet": true
    },
    {
      "id": "claim-w1",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "ops"
      },
      "end": {
        "id": "w1"
      },
      "label": {
        "text": "领取"
      }
    },
    {
      "id": "claim-w2",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "ops"
      },
      "end": {
        "id": "w2"
      }
    },
    {
      "id": "w-models",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "workers"
      },
      "end": {
        "id": "models"
      }
    },
    {
      "id": "w-mem",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "workers"
      },
      "end": {
        "id": "mem"
      },
      "quiet": true
    },
    {
      "id": "iw-mem",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "iworker"
      },
      "end": {
        "id": "mem"
      },
      "quiet": true
    }
  ],
  "scenes": [
    {
      "label": "Retain（存入）· 异步",
      "caption": "",
      "beats": [
        {
          "edges": {
            "edge": "app-http",
            "data": "retain(async=true)"
          },
          "show": {
            "app": [
              {
                "tag": "retain",
                "tone": "gray",
                "text": "“Alice 于三月加入 Google。”",
                "meta": "async=true"
              }
            ]
          },
          "say": "存入操作处理耗时较长：LLM 需要读取内容。设置 async=true 后，API 不会在当前请求中执行这项工作。"
        },
        {
          "edges": {
            "edge": "http-ops",
            "data": "op_7f3 · 等待处理"
          },
          "show": {
            "ops": [
              {
                "tag": "retain",
                "tone": "orange",
                "text": "op_7f3",
                "meta": "等待处理"
              }
            ]
          },
          "say": "API 会向 async_operations 写入一条任务记录；队列只是同一数据库中的一张表。"
        },
        {
          "edges": {
            "edge": "app-http",
            "back": true,
            "data": "{ operation_id }"
          },
          "show": {
            "app": [
              {
                "tag": "retain",
                "tone": "gray",
                "text": "“Alice 于三月加入 Google。”",
                "meta": "async=true"
              },
              {
                "tag": "已接收",
                "tone": "green",
                "text": "op_7f3"
              }
            ]
          },
          "say": "API 会立即返回操作 ID。"
        },
        {
          "edges": [
            {
              "edge": "claim-w1",
              "data": "FOR UPDATE SKIP LOCKED"
            }
          ],
          "show": {
            "ops": [
              {
                "tag": "retain",
                "tone": "orange",
                "text": "op_7f3",
                "meta": "处理中 · worker-1"
              }
            ],
            "w1": [
              {
                "text": "retain op_7f3",
                "mono": true,
                "mark": "…"
              }
            ],
            "w2": [
              {
                "text": "该行已锁定，跳过",
                "meta": "空闲"
              }
            ]
          },
          "say": "每个工作进程每 500 ms 轮询一次该表。领取任务时会锁定该行，因此恰有一个工作进程能领取该任务，其余进程会跳过。",
          "ms": 2800
        },
        {
          "edges": {
            "edge": "w-models",
            "data": "提取 · 生成嵌入"
          },
          "show": {
            "llm": [
              {
                "text": "提取事实"
              }
            ],
            "emb": [
              {
                "text": "为 1 条事实生成嵌入"
              }
            ]
          },
          "say": "工作进程调用 LLM 提取事实并为其生成嵌入。"
        },
        {
          "edges": {
            "edge": "w-mem",
            "data": "1 fact"
          },
          "show": {
            "mem": [
              {
                "tag": "world",
                "text": "Alice 加入 Google",
                "meta": "Mar 2026",
                "mark": "new"
              }
            ]
          },
          "say": "随后，工作进程将这些事实写入记忆库。"
        },
        {
          "edges": {
            "edge": "claim-w1",
            "back": true,
            "data": "已完成"
          },
          "show": {
            "ops": [
              {
                "tag": "retain",
                "tone": "orange",
                "text": "op_7f3",
                "meta": "已完成",
                "mark": "✓"
              },
              {
                "tag": "consolidation",
                "tone": "orange",
                "text": "op_8a1",
                "meta": "等待处理"
              }
            ],
            "w1": [
              {
                "text": "retain op_7f3",
                "mono": true,
                "mark": "✓"
              }
            ]
          },
          "say": "任务状态标记为 `completed`。新事实会触发后续任务入队：启用自动整合时执行整合，并维护图和索引。",
          "ms": 2800
        },
        {
          "edges": {
            "edge": "cp-http",
            "data": "操作状态"
          },
          "show": {
            "cp": [
              {
                "text": "op_7f3",
                "meta": "已完成",
                "mark": "✓"
              }
            ]
          },
          "say": "控制台连接到同一个 API，因此可以在那里查看操作状态。"
        }
      ]
    },
    {
      "label": "后台处理",
      "caption": "",
      "beats": [
        {
          "edges": {
            "edge": "claim-w2",
            "data": "consolidation"
          },
          "show": {
            "ops": [
              {
                "tag": "consolidation",
                "tone": "orange",
                "text": "op_8a1",
                "meta": "处理中 · worker-2"
              }
            ],
            "w2": [
              {
                "text": "consolidation op_8a1",
                "mono": true,
                "mark": "…"
              }
            ]
          },
          "say": "后台任务也经由同一队列处理。这次由 worker-2 领取了任务。"
        },
        {
          "edges": {
            "edge": "w-models",
            "data": "整合"
          },
          "show": {
            "llm": [
              {
                "text": "将事实整合进观测"
              }
            ]
          },
          "say": "观测整合会让 LLM 将新事实整合到观测中。"
        },
        {
          "edges": {
            "edge": "w-mem",
            "data": "observation"
          },
          "show": {
            "mem": [
              {
                "tag": "observation",
                "tone": "green",
                "text": "Alice 在 Google 工作",
                "meta": "1 条来源",
                "mark": "new"
              }
            ]
          }
        },
        {
          "edges": {
            "edge": "claim-w2",
            "back": true,
            "data": "已加入刷新队列"
          },
          "show": {
            "ops": [
              {
                "tag": "consolidation",
                "tone": "orange",
                "text": "op_8a1",
                "meta": "已完成",
                "mark": "✓"
              },
              {
                "tag": "refresh_mental_model",
                "tone": "orange",
                "text": "op_9c4",
                "meta": "等待处理"
              }
            ],
            "w2": [
              {
                "text": "consolidation op_8a1",
                "mono": true,
                "mark": "✓"
              }
            ]
          },
          "say": "配置为在整合后刷新的心智模型，如果此时内容已待更新，就会各自获得一条刷新任务。",
          "ms": 2600
        },
        {
          "edges": {
            "edge": "claim-iw",
            "data": "领取"
          },
          "show": {
            "ops": [
              {
                "tag": "refresh_mental_model",
                "tone": "orange",
                "text": "op_9c4",
                "meta": "处理中 · API"
              }
            ],
            "iworker": [
              {
                "text": "refresh_mental_model op_9c4",
                "mono": true,
                "mark": "…"
              }
            ]
          },
          "say": "API 的内置工作进程也从同一张表领取任务。设置 HINDSIGHT_API_WORKER_ENABLED=false 后，只有独立工作进程会领取任务。",
          "ms": 3000
        },
        {
          "edges": {
            "edge": "iw-mem",
            "data": "重写心智模型"
          },
          "show": {
            "mem": [
              {
                "tag": "observation",
                "tone": "green",
                "text": "Alice 在 Google 工作",
                "meta": "1 条来源"
              },
              {
                "tag": "model",
                "tone": "orange",
                "text": "团队概况",
                "mark": "↻"
              }
            ],
            "iworker": [
              {
                "text": "refresh_mental_model op_9c4",
                "mono": true,
                "mark": "✓"
              }
            ]
          },
          "say": "所有工作进程都能执行任何任务：它们共用软件包、镜像和数据库，因此增加工作进程即可扩展处理能力。",
          "ms": 3000
        }
      ]
    },
    {
      "label": "Recall（召回）· 同步",
      "caption": "",
      "beats": [
        {
          "edges": {
            "edge": "app-http",
            "data": "recall()"
          },
          "show": {
            "app": [
              {
                "tag": "recall",
                "tone": "gray",
                "text": "“Alice 在哪里工作？”"
              }
            ]
          },
          "say": "之后，应用调用 Recall。与 Reflect 及其他读取操作一样，API 进程会直接处理并返回结果，不会将其加入队列。"
        },
        {
          "edges": {
            "edge": "http-emb",
            "data": "为查询生成嵌入"
          },
          "show": {
            "http": [
              {
                "text": "记忆召回",
                "meta": "记忆库 alice-team",
                "mono": true
              }
            ],
            "emb": [
              {
                "text": "查询 → 向量"
              }
            ]
          },
          "say": "查询会通过进程内加载的模型或远程嵌入服务转换为嵌入。"
        },
        {
          "edges": {
            "edge": "http-mem",
            "data": "四路搜索"
          },
          "show": {
            "mem": [
              {
                "tag": "world",
                "text": "Alice 加入 Google",
                "meta": "Mar 2026",
                "mark": "✓"
              }
            ]
          },
          "say": "四路搜索会以查询的形式在 PostgreSQL 中执行，所有记忆库都存储在其中。"
        },
        {
          "edges": {
            "edge": "http-emb",
            "data": "重排"
          },
          "show": {
            "emb": [
              {
                "text": "查询 → 向量"
              },
              {
                "text": "交叉编码器重排"
              }
            ]
          },
          "say": "交叉编码器会对候选结果重新排序；与嵌入服务一样，它可以在本地或远程运行。"
        },
        {
          "edges": {
            "edge": "app-http",
            "back": true,
            "data": "排序后的记忆"
          },
          "show": {
            "app": [
              {
                "tag": "recall",
                "tone": "gray",
                "text": "“Alice 在哪里工作？”"
              },
              {
                "tag": "结果",
                "tone": "green",
                "text": "Alice 加入 Google",
                "mark": "✓"
              }
            ]
          },
          "say": "API 本身不持有状态，因此可以在负载均衡器后运行任意数量的副本。"
        }
      ]
    }
  ]
}
