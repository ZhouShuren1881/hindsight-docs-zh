      "end": {
        "id": "mem"
      },
      "quiet": true
    }
  ],
  "scenes": [
    {
      "label": "记忆存储·异步",
      "caption": "",
      "beats": [
        {
          "edges": {
            "edge": "app-http",
            "data": "retain(async=true)"
          },
          "show": {
            "app": [
              {
                "tag": "retain",
                "tone": "gray",
                "text": "“Alice于三月加入Google。”",
                "meta": "async=true"
              }
            ]
          },
          "say": "记忆存储需要 LLM 读取内容，耗时较长。设置 async=true 后，API 不会在请求内执行这项工作。"
        },
        {
          "edges": {
            "edge": "http-ops",
            "data": "op_7f3 · pending"
          },
          "show": {
            "ops": [
              {
                "tag": "retain",
                "tone": "orange",
                "text": "op_7f3",
                "meta": "pending"
              }
            ]
          },
          "say": "API 将任务记录写入 async_operations。队列就是同一数据库中的一张表。"
        },
        {
          "edges": {
            "edge": "app-http",
            "back": true,
            "data": "{ operation_id }"
          },
          "show": {
            "app": [
              {
                "tag": "retain",
                "tone": "gray",
                "text": "“Alice于三月加入Google。”",
                "meta": "async=true"
              },
              {
                "tag": "accepted",
                "tone": "green",
                "text": "op_7f3"
              }
            ]
          },
          "say": "立即返回操作 ID。"
        },
        {
          "edges": [
            {
              "edge": "claim-w1",
              "data": "FOR UPDATE SKIP LOCKED"
            }
          ],
          "show": {
            "ops": [
              {
                "tag": "retain",
                "tone": "orange",
                "text": "op_7f3",
                "meta": "processing · worker-1"
              }
            ],
            "w1": [
              {
                "text": "retain op_7f3",
                "mono": true,
                "mark": "…"
              }
            ],
            "w2": [
              {
                "text": "行已锁定，跳过它",
                "meta": "idle"
              }
            ]
          },
          "say": "每个工作进程每 500 ms 轮询这张表。领取任务时锁定记录，确保只有一个进程获得任务，其他进程跳过。",
          "ms": 2800
        },
        {
          "edges": {
            "edge": "w-models",
            "data": "extract · embed"
          },
          "show": {
            "llm": [
              {
                "text": "摘录事实"
              }
            ],
            "emb": [
              {
                "text": "嵌入 1 个事实"
              }
            ]
          },
          "say": "工作进程调用 LLM 提取事实，并生成嵌入。"
        },
        {
          "edges": {
            "edge": "w-mem",
            "data": "1 fact"
          },
          "show": {
            "mem": [
              {
                "tag": "world",
                "text": "Alice加入Google",
                "meta": "Mar 2026",
                "mark": "new"
              }
            ]
          },
          "say": "随后将事实写入记忆库。"
        },
        {
          "edges": {
            "edge": "claim-w1",
            "back": true,
            "data": "completed"
          },
          "show": {
            "ops": [
              {
                "tag": "retain",
                "tone": "orange",
                "text": "op_7f3",
                "meta": "completed",
                "mark": "✓"
              },
              {
                "tag": "consolidation",
                "tone": "orange",
                "text": "op_8a1",
                "meta": "pending"
              }
            ],
            "w1": [
              {
                "text": "retain op_7f3",
                "mono": true,
                "mark": "✓"
              }
            ]
          },
          "say": "任务标记为 completed。新事实会排队后续工作：启用自动整合时执行整合，并维护图与索引。",
          "ms": 2800
        },
        {
          "edges": {
            "edge": "cp-http",
            "data": "operation status"
          },
          "show": {
            "cp": [
              {
                "text": "op_7f3",
                "meta": "completed",
                "mark": "✓"
              }
            ]
          },
          "say": "控制平面连接相同 API，因此可以在那里查看操作状态。"
        }
      ]
    },
    {
      "label": "背景",
      "caption": "",
      "beats": [
        {
          "edges": {
            "edge": "claim-w2",
            "data": "consolidation"
          },
          "show": {
            "ops": [
              {
                "tag": "consolidation",
                "tone": "orange",
                "text": "op_8a1",
                "meta": "processing · worker-2"
              }
            ],
            "w2": [
              {
                "text": "consolidation op_8a1",
                "mono": true,
                "mark": "…"
              }
            ]
          },
          "say": "后台任务通过同一队列执行。这次 worker-2 成功领取任务。"
        },
        {
          "edges": {
            "edge": "w-models",
            "data": "consolidate"
          },
          "show": {
            "llm": [
              {
                "text": "将事实融入观察"
              }
            ]
          },
          "say": "整合要求 LLM 将新事实合并到观察中。"
        },
        {
          "edges": {
            "edge": "w-mem",
            "data": "observation"
          },
          "show": {
            "mem": [
              {
                "tag": "observation",
                "tone": "green",
                "text": "Alice在Google工作",
                "meta": "1 source",
                "mark": "new"
              }
            ]
          }
        },
        {
          "edges": {
            "edge": "claim-w2",
            "back": true,
            "data": "refresh queued"
          },
          "show": {
            "ops": [
              {
                "tag": "consolidation",
                "tone": "orange",
                "text": "op_8a1",
                "meta": "completed",
                "mark": "✓"
              },
              {
                "tag": "refresh_mental_model",
                "tone": "orange",
                "text": "op_9c4",
                "meta": "pending"
              }
            ],
            "w2": [
              {
                "text": "consolidation op_8a1",
                "mono": true,
                "mark": "✓"
              }
            ]
          },
          "say": "配置为整合后刷新、且当前已过时的心智模型，会获得各自的刷新任务。",
          "ms": 2600
        },
        {
          "edges": {
            "edge": "claim-iw",
            "data": "claim"
          },
          "show": {
            "ops": [
              {
                "tag": "refresh_mental_model",
                "tone": "orange",
                "text": "op_9c4",
                "meta": "processing · api"
              }
            ],
            "iworker": [
              {
                "text": "refresh_mental_model op_9c4",
                "mono": true,
                "mark": "…"
              }
            ]
          },
          "say": "API 内置工作进程也从同一张表领取任务。设置 HINDSIGHT_API_WORKER_ENABLED=false 后，仅独立工作进程领取任务。",
          "ms": 3000
        },
        {
          "edges": {
            "edge": "iw-mem",
            "data": "rewrite model"
          },
          "show": {
            "mem": [
              {
                "tag": "observation",
                "tone": "green",
                "text": "Alice在Google工作",
                "meta": "1 source"
              },
              {
                "tag": "model",
                "tone": "orange",
                "text": "团队概况",
                "mark": "↻"
              }
            ],
            "iworker": [
              {
                "text": "refresh_mental_model op_9c4",
                "mono": true,
                "mark": "✓"
              }
            ]
          },
          "say": "所有工作进程都能执行所有任务，使用相同软件包、镜像与数据库，增加进程即可扩容。",
          "ms": 3000
        }
      ]
    },
    {
      "label": "记忆召回·同步",
      "caption": "",
      "beats": [
        {
          "edges": {
            "edge": "app-http",
            "data": "recall()"
          },
          "show": {
            "app": [
              {
                "tag": "recall",
                "tone": "gray",
                "text": "“Alice在哪里工作？”"
              }
            ]
          },
          "say": "之后进行记忆召回。与反思及其他读取一样，它在 API 进程内直接响应，不进入队列。"
        },
        {
          "edges": {
            "edge": "http-emb",
            "data": "embed the query"
          },
          "show": {
            "http": [
              {
                "text": "记忆召回",
                "meta": "bank alice-team",
                "mono": true
              }
            ],
            "emb": [
              {
                "text": "查询 → 向量"
              }
            ]
          },
          "say": "查询由进程内加载的模型或远程嵌入服务转换为嵌入。"
        },
        {
          "edges": {
            "edge": "http-mem",
            "data": "4-way search"
          },
          "show": {
            "mem": [
              {
                "tag": "world",
                "text": "Alice加入Google",
                "meta": "Mar 2026",
                "mark": "✓"
              }
            ]
          },
          "say": "四路搜索以 PostgreSQL 查询执行，各记忆库都存储在其中。"
        },
        {
          "edges": {
            "edge": "http-emb",
            "data": "rerank"
          },
          "show": {
            "emb": [
              {
                "text": "查询 → 向量"
              },
              {
                "text": "交叉编码器重新排序"
              }
            ]
          },
          "say": "交叉编码器对候选结果重新排序，与嵌入服务一样，可以在本地或远程运行。"
        },
        {
          "edges": {
            "edge": "app-http",
            "back": true,
            "data": "ranked memories"
          },
          "show": {
            "app": [
              {
                "tag": "recall",
                "tone": "gray",
                "text": "“Alice在哪里工作？”"
              },
              {
                "tag": "result",
                "tone": "green",
                "text": "Alice加入Google",
                "mark": "✓"
              }
            ]
          },
          "say": "API 不持有自身状态，可以在负载均衡器后部署任意数量的副本。"
        }
      ]
    }
  ]
}
