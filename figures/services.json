      "type": "rectangle",
      "content": [
        {
          "type": "title",
          "text": "worker-2"
        }
      ]
    },
    {
      "id": "workers",
      "type": "group",
      "label": {
        "title": "hindsight-worker × N"
      },
      "children": [
        "w1",
        "w2"
      ],
      "layout": {
        "direction": "column",
        "gap": 16,
        "align": "stretch"
