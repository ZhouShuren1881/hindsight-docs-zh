{
  "title": "记忆库模板",
  "speed": 2200,
  "elements": [
    {
      "id": "s-config",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "配置"
        },
        {
          "type": "subtitle",
          "text": "记忆库级覆盖项"
        }
      ],
      "minCardHeight": 58
    },
    {
      "id": "s-mm",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "心智模型"
        }
      ],
      "minCardHeight": 58
    },
    {
      "id": "s-dir",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "强制指令"
        }
      ],
      "minCardHeight": 28
    },
    {
      "id": "s-mem",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "记忆"
        }
      ],
      "minCardHeight": 28
    },
    {
      "id": "src",
      "type": "group",
      "label": {
        "title": "已调优的记忆库"
      },
      "children": [
        "s-config",
        "s-mm",
        "s-dir",
        "s-mem"
      ],
      "layout": {
        "direction": "column",
        "gap": 12,
        "align": "stretch"
      }
    },
    {
      "id": "export",
      "type": "rectangle",
      "content": [
        {
          "type": "title",
          "text": "导出"
        }
      ],
      "minCardHeight": 73
    },
    {
      "id": "hub",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "模板中心"
        },
        {
          "type": "subtitle",
          "text": "现成模板清单"
        }
      ],
      "minCardHeight": 58,
      "width": 200
    },
    {
      "id": "manifest",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "清单"
        },
        {
          "type": "subtitle",
          "text": "JSON"
        }
      ],
      "minCardHeight": 193,
      "width": 200
    },
    {
      "id": "g1",
      "type": "group",
      "children": [
        "hub",
        "manifest"
      ],
      "layout": {
        "direction": "column",
        "gap": 40,
        "align": "stretch"
      }
    },
    {
      "id": "import",
      "type": "rectangle",
      "content": [
        {
          "type": "title",
          "text": "导入"
        }
      ],
      "minCardHeight": 88,
      "width": 170
    },
    {
      "id": "refresh",
      "type": "rectangle",
      "content": [
        {
          "type": "title",
          "text": "刷新"
        },
        {
          "type": "subtitle",
          "text": "心智模型内容"
        }
      ],
      "minCardHeight": 43
    },
    {
      "id": "g2",
      "type": "group",
      "label": {
        "title": "Hindsight",
        "logo": "/img/logo.webp"
      },
      "children": [
        "import",
        "refresh"
      ],
      "layout": {
        "direction": "column",
        "gap": 40,
        "align": "stretch"
      }
    },
    {
      "id": "d-config",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "配置"
        },
        {
          "type": "subtitle",
          "text": "记忆库级覆盖项"
        }
      ],
      "minCardHeight": 73
    },
    {
      "id": "d-mm",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "心智模型"
        }
      ],
      "minCardHeight": 58
    },
    {
      "id": "d-dir",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "强制指令"
        }
      ],
      "minCardHeight": 28
    },
    {
      "id": "d-mem",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "记忆"
        }
      ],
      "minCardHeight": 28
    },
    {
      "id": "dst",
      "type": "group",
      "label": {
        "title": "新记忆库"
      },
      "children": [
        "d-config",
        "d-mm",
        "d-dir",
        "d-mem"
      ],
      "layout": {
        "direction": "column",
        "gap": 12,
        "align": "stretch"
      }
    },
    {
      "id": "g0",
      "type": "group",
      "children": [
        "src",
        "export",
        "g1",
        "g2",
        "dst"
      ],
      "layout": {
        "direction": "row",
        "gap": 32,
        "align": "center"
      }
    },
    {
      "id": "out",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "src"
      },
      "end": {
        "id": "export"
      },
      "label": {
        "text": "导出"
      }
    },
    {
      "id": "to-manifest",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "export"
      },
      "end": {
        "id": "manifest"
      }
    },
    {
      "id": "from-hub",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "hub"
      },
      "end": {
        "id": "manifest"
      },
      "label": {
        "text": "复制"
      }
    },
    {
      "id": "in",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "manifest"
      },
      "end": {
        "id": "import"
      },
      "label": {
        "text": "导入"
      }
    },
    {
      "id": "apply",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "import"
      },
      "end": {
        "id": "dst"
      }
    },
    {
      "id": "queue",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "import"
      },
      "end": {
        "id": "refresh"
      }
    },
    {
      "id": "gen",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "refresh"
      },
      "end": {
        "id": "d-mm"
      }
    }
  ],
  "scenes": [
    {
      "label": "导出",
      "caption": "",
      "beats": [
        {
          "show": {
            "s-config": [
              {
                "text": "retain_mission",
                "mono": true,
                "meta": "已设置"
              },
              {
                "text": "enable_observations",
                "mono": true,
                "meta": "true"
              }
            ],
            "s-mm": [
              {
                "text": "project-context",
                "mono": true,
                "meta": "已填充"
              }
            ],
            "s-dir": [
              {
                "text": "引用文件路径"
              }
            ],
            "s-mem": [
              {
                "text": "1,240 条记忆"
              }
            ]
          },
          "say": "这是一个已经调优的记忆库：包含它自己的配置、心智模型、强制指令，以及它已经学到的记忆。",
          "ms": 2800
        },
        {
          "edges": {
            "edge": "out",
            "data": "export"
          },
          "show": {
            "export": [
              {
                "text": "仅包含此记忆库的覆盖项"
              },
              {
                "text": "不含服务器默认值，不含 API 密钥"
              }
            ]
          },
          "say": "导出会读取这套配置，只保留此记忆库设置的配置项；不会包含服务器默认值，也绝不会包含凭据，因此清单可以移植。",
          "ms": 3000
        },
        {
          "edges": "to-manifest",
          "show": {
            "manifest": [
              {
                "tag": "version",
                "tone": "gray",
                "text": "\"1\"",
                "mono": true
              },
              {
                "tag": "bank",
                "tone": "blue",
                "text": "retain_mission, enable_observations"
              },
              {
                "tag": "mental_models",
                "tone": "orange",
                "text": "project-context",
                "meta": "整合后刷新"
              },
              {
                "tag": "directives",
                "tone": "purple",
                "text": "引用文件路径"
              }
            ],
            "s-mem": [
              {
                "text": "1,240 条记忆",
                "mark": "stay"
              }
            ]
          },
          "say": "清单是普通 JSON：包含配置、心智模型定义（不含其内容）和强制指令；其中绝不会包含记忆。",
          "ms": 3200
        }
      ]
    },
    {
      "label": "导入",
      "caption": "",
      "beats": [
        {
          "edges": {
            "edge": "in",
            "data": "import"
          },
          "show": {
            "manifest": [
              {
                "tag": "version",
                "tone": "gray",
                "text": "\"1\"",
                "mono": true
              },
              {
                "tag": "bank",
                "tone": "blue",
                "text": "retain_mission, enable_observations"
              },
              {
                "tag": "mental_models",
                "tone": "orange",
                "text": "project-context",
                "meta": "整合后刷新"
              },
              {
                "tag": "directives",
                "tone": "purple",
                "text": "引用文件路径"
              }
            ]
          },
          "say": "将清单导入另一个记忆库。如果该记忆库尚不存在，系统会创建它。"
        },
        {
          "show": {
            "import": [
              {
                "text": "清单有效",
                "mark": "✓"
              },
              {
                "text": "配置：2 个覆盖项"
              },
              {
                "text": "心智模型：新增 1 个"
              },
              {
                "text": "强制指令：新增 1 条"
              }
            ]
          },
          "say": "系统会先检查清单。试运行会在此处停止，并显示将要发生的更改。",
          "ms": 2800
        },
        {
          "edges": "apply",
          "show": {
            "d-config": [
              {
                "text": "retain_mission",
                "mono": true,
                "meta": "已设置"
              },
              {
                "text": "enable_observations",
                "mono": true,
                "meta": "true"
              }
            ],
            "d-mm": [
              {
                "text": "project-context",
                "mono": true,
                "meta": "暂无内容"
              }
            ],
            "d-dir": [
              {
                "text": "引用文件路径"
              }
            ],
            "d-mem": [
              {
                "text": "空"
              }
            ]
          },
          "say": "配置将成为记忆库级覆盖项。心智模型按 ID 匹配，强制指令按名称匹配；系统会创建新条目并更新已有条目。",
          "ms": 3400
        },
        {
          "edges": {
            "edge": "queue",
            "data": "operation_ids"
          },
          "show": {
            "refresh": [
              {
                "text": "已将 1 项刷新任务加入队列"
              },
              {
                "text": "目前还没有可读取的内容"
              }
            ]
          },
          "say": "心智模型内容会在后台生成。响应会返回操作 ID，供您跟踪进度。"
        },
        {
          "edges": "gen",
          "show": {
            "d-mm": [
              {
                "text": "project-context",
                "mono": true,
                "meta": "随着记忆到来逐步填充"
              }
            ]
          },
          "say": "新记忆库尚无记忆，因此目前没有内容可读。心智模型会在每次整合后刷新，随着记忆库不断学习而逐渐填充。行为相同，记忆库是新的。",
          "ms": 3200
        }
      ]
    },
    {
      "label": "来自中心",
      "caption": "",
      "beats": [
        {
          "show": {
            "hub": [
              {
                "text": "编码智能体",
                "mark": "✓"
              },
              {
                "text": "对话"
              },
              {
                "text": "个人助手",
                "meta": "+ 更多"
              }
            ]
          },
          "light": [
            "hub"
          ],
          "say": "也可以跳过导出步骤：模板中心提供现成的清单，您可以先阅读再使用。"
        },
        {
          "edges": {
            "edge": "from-hub",
            "data": "编程智能体"
          },
          "show": {
            "manifest": [
              {
                "tag": "version",
                "tone": "gray",
                "text": "\"1\"",
                "mono": true
              },
              {
                "tag": "bank",
                "tone": "blue",
                "text": "retain_mission、enable_observations、observations_mission、disposition_*"
              },
              {
                "tag": "mental_models",
                "tone": "orange",
                "text": "project-context, developer-preferences, review-patterns"
              }
            ]
          },
          "say": "复制一个模板即可；其 JSON 格式与导出生成的格式相同。"
        },
        {
          "edges": {
            "edge": "in",
            "data": "import"
          },
          "say": "然后以相同方式导入。"
        },
        {
          "edges": "apply",
          "show": {
            "d-config": [
              {
                "text": "retain_mission",
                "mono": true,
                "meta": "已设置"
              },
              {
                "text": "enable_observations",
                "mono": true,
                "meta": "true"
              },
              {
                "text": "observations_mission",
                "mono": true,
                "meta": "已设置"
              },
              {
                "text": "disposition_*",
                "mono": true,
                "meta": "字面解读倾向 5 · 怀疑倾向 3"
              }
            ],
            "d-mm": [
              {
                "text": "3 个心智模型",
                "meta": "随着记忆到来逐步填充"
              }
            ],
            "d-dir": [
              {
                "text": "此模板中没有强制指令"
              }
            ],
            "d-mem": [
              {
                "text": "空"
              }
            ]
          },
          "say": "新记忆库从经过验证的配置开始，而不必从零开始。",
          "ms": 3000
        }
      ]
    }
  ]
}
