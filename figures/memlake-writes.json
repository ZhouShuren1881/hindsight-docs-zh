  "scenes": [
    {
      "label": "写入",
      "beats": [
        {
          "edges": {
            "edge": "hs-sA",
            "data": "retain(doc)"
          },
          "show": {
            "hs": [
              {
                "tag": "retain",
                "tone": "blue",
                "text": "新增事实 + 实体 + 替换旧内容"
              }
            ]
          },
          "say": "Hindsight 对文档执行 Retain：替换旧事实、写入新事实并登记新实体——一次写入完成。"
        },
        {
          "edges": {
            "edge": "sA-log",
            "data": "PUT wal/43 · if-none-match"
          },
          "show": {
            "log": [
              {
                "tag": "wal/41",
                "tone": "orange",
                "text": "已索引"
              },
              {
                "tag": "wal/42",
                "tone": "orange",
                "text": "已提交"
              },
              {
                "tag": "wal/43",
                "tone": "green",
                "text": "已领取 · 已持久化"
              }
            ]
          },
          "say": "服务器通过条件创建领取下一个日志槽位。两个写入方绝不会领取同一个槽位。",
          "ms": 3200
        },
        {
          "edges": {
            "edge": "sA-manifest",
            "data": "head → 43 · if-match"
          },
          "show": {
            "manifest": [
              {
                "tag": "head",
                "tone": "purple",
                "text": "43"
              }
            ]
          },
          "say": "记录持久化后，head 指针向前推进——这也是一次条件写入。"
        },
        {
          "edges": {
            "edge": "hs-sA",
            "back": true,
            "data": "✓ 已保存"
          },
          "light": [
            "log",
            "manifest"
          ],
          "say": "之后才会确认写入成功。此时它已可搜索，无需等待索引器。"
        }
      ]
    }
  ],
  "view": {
    "width": 1280,
    "height": 760
  }
