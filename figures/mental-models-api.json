              {
                "text": "• Alice：Google 研究团队",
                "mark": "="
              },
              {
                "text": "• Bob：领导 ML 项目",
                "mark": "="
              },
              {
                "text": "• Carol：加入 ML 项目",
                "mark": "new"
              }
            ]
