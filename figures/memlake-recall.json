                "tone": "blue",
                "text": "实体 · 连接"
              },
              {
                "tag": "time",
                "tone": "blue",
                "text": "时间窗口"
              }
            ]
          },
          "light": [
            "sA"
          ],
          "say": "四种搜索同时处理同一批记忆……",
          "ms": 2800
        },
        {
          "show": {
            "sA": [
              {
                "tag": "ranked",
                "tone": "green",
                "text": "已融合 · 已重排序 · 符合预算"
