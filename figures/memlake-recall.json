    {
      "label": "Recall",
      "beats": [
        {
          "edges": {
            "edge": "hs-sA",
            "data": "recall(query)"
          },
          "show": {
            "hs": [
              {
                "tag": "recall",
                "tone": "blue",
                "text": "+ 排序策略：融合 · 重排序 · 预算"
              }
            ]
          },
          "say": "Hindsight 发送 Recall 请求，并附上排序策略。"
        },
        {
          "edges": {
            "edge": "sA-manifest",
            "data": "最新 head？"
          },
          "say": "服务器检查最新写入——热查询始终只需发出这一次请求。"
        },
        {
          "edges": [
            {
              "edge": "sA-segs",
              "data": "范围读取"
            },
            {
              "edge": "sA-log",
