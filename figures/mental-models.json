{
  "title": "心智模型",
  "speed": 2200,
  "elements": [
    {
      "id": "app",
      "type": "rectangle",
      "content": [
        {
          "type": "title",
          "text": "你的应用"
        }
      ],
      "minCardHeight": 103,
      "width": 200
    },
    {
      "id": "api",
      "type": "rectangle",
      "content": [
        {
          "type": "title",
          "text": "心智模型 API"
        },
        {
          "type": "subtitle",
          "text": "创建 · 读取"
        }
      ]
    },
    {
      "id": "trigger",
      "type": "rectangle",
      "content": [
        {
          "type": "title",
          "text": "触发器"
        },
        {
          "type": "subtitle",
          "text": "整合后，或按 cron 计划"
        }
      ],
      "minCardHeight": 43,
      "width": 200
    },
    {
      "id": "reflect",
      "type": "rectangle",
      "content": [
        {
          "type": "title",
          "text": "Reflect（反思）"
        },
        {
          "type": "subtitle",
          "text": "回答问题"
        }
      ],
      "minCardHeight": 58,
      "width": 200
    },
    {
      "id": "g2",
      "type": "group",
      "label": {
        "title": "Hindsight 工作进程"
      },
      "children": [
        "trigger",
        "reflect"
      ],
      "layout": {
        "direction": "column",
        "gap": 32,
        "align": "stretch"
      }
    },
    {
      "id": "g1",
      "type": "group",
      "label": {
        "title": "Hindsight",
        "logo": "/img/logo.webp"
      },
      "children": [
        "api",
        "g2"
      ],
      "layout": {
        "direction": "column",
        "gap": 32,
        "align": "stretch"
      }
    },
    {
      "id": "obs",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "观测"
        }
      ],
      "minCardHeight": 103,
      "width": 200
    },
    {
      "id": "facts",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "事实"
        }
      ],
      "minCardHeight": 73,
      "width": 190
    },
    {
      "id": "sources",
      "type": "group",
      "label": {
        "title": "读取"
      },
      "children": [
        "obs",
        "facts"
      ],
      "layout": {
        "direction": "row",
        "gap": 24,
        "align": "center"
      }
    },
    {
      "id": "mm",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "心智模型"
        },
        {
          "type": "subtitle",
          "text": "团队概况"
        }
      ],
      "minCardHeight": 133,
      "width": 200
    },
    {
      "id": "hist",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "历史"
        },
        {
          "type": "subtitle",
          "text": "以前的版本"
        }
      ],
      "minCardHeight": 43,
      "width": 190
    },
    {
      "id": "g4",
      "type": "group",
      "label": {
        "title": "写入"
      },
      "children": [
        "mm",
        "hist"
      ],
      "layout": {
        "direction": "row",
        "gap": 24,
        "align": "center"
      }
    },
    {
      "id": "g3",
      "type": "group",
      "label": {
        "title": "记忆库"
      },
      "children": [
        "sources",
        "g4"
      ],
      "layout": {
        "direction": "column",
        "gap": 32,
        "align": "stretch"
      }
    },
    {
      "id": "g0",
      "type": "group",
      "children": [
        "app",
        "g1",
        "g3"
      ],
      "layout": {
        "direction": "row",
        "gap": 40,
        "align": "center"
      }
    },
    {
      "id": "call",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "app"
      },
      "end": {
        "id": "api"
      }
    },
    {
      "id": "build",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "api"
      },
      "end": {
        "id": "reflect"
      },
      "label": {
        "text": "首次构建"
      },
      "quiet": true
    },
    {
      "id": "read-src",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "reflect"
      },
      "end": {
        "id": "sources"
      }
    },
    {
      "id": "write",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "reflect"
      },
      "end": {
        "id": "mm"
      },
      "label": {
        "text": "写入"
      }
    },
    {
      "id": "version",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "mm"
      },
      "end": {
        "id": "hist"
      }
    },
    {
      "id": "changed",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "sources"
      },
      "end": {
        "id": "trigger"
      },
      "label": {
        "text": "范围内发生变化"
      }
    },
    {
      "id": "refresh",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "trigger"
      },
      "end": {
        "id": "reflect"
      },
      "label": {
        "text": "刷新"
      }
    },
    {
      "id": "read",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "api"
      },
      "end": {
        "id": "mm"
      },
      "label": {
        "text": "读取"
      },
      "quiet": true
    }
  ],
  "scenes": [
    {
      "label": "创建",
      "caption": "",
      "beats": [
        {
          "edges": {
            "edge": "call",
            "data": "来源问题"
          },
          "show": {
            "app": [
              {
                "tag": "问题",
                "tone": "gray",
                "text": "“团队中有哪些人，每个人都负责什么工作？”"
              },
              {
                "tag": "触发器",
                "tone": "gray",
                "text": "整合后刷新",
                "meta": "增量模式"
              }
            ]
          },
          "say": "你只需定义一次问题，并指定如何让答案保持最新。"
        },
        {
          "edges": {
            "edge": "build",
            "data": "构建模型"
          },
          "show": {
            "reflect": [
              {
                "text": "对这个记忆库进行反思",
                "meta": "限定在模型的标签范围内"
              }
            ]
          },
          "say": "Hindsight 在后台通过 Reflect 生成答案。标签会限制它可以读取的记忆。"
        },
        {
          "edges": {
            "edge": "read-src",
            "data": "观测 + 事实"
          },
          "show": {
            "obs": [
              {
                "text": "Bob 负责运行检索评估",
                "meta": "4 个来源",
                "mark": "✓"
              },
              {
                "text": "Carol 转到 ML 团队，负责微调排序器",
                "meta": "3 个来源",
                "mark": "✓"
              }
            ],
            "facts": [
              {
                "tag": "world",
                "tone": "blue",
                "text": "Carol 转入 ML 团队",
                "meta": "2026 年 2 月",
                "mark": "✓"
              }
            ]
          },
          "say": "它先读取整合后的观测，再通过原始事实核对细节。",
          "ms": 2800
        },
        {
          "edges": {
            "edge": "write",
            "data": "文档 v1"
          },
          "show": {
            "mm": [
              {
                "tag": "研究",
                "tone": "blue",
                "text": "Bob：检索评估"
              },
              {
                "tag": "ML 团队",
                "tone": "purple",
                "text": "Carol：微调排序器"
              },
              {
                "text": "依据 2 条观测、1 条事实",
                "meta": "v1"
              }
            ]
          },
          "say": "答案以文档形式存储，同时保留生成它所依据的证据。",
          "ms": 3000
        }
      ]
    },
    {
      "label": "保持最新",
      "caption": "",
      "beats": [
        {
          "show": {
            "obs": [
              {
                "text": "Bob 负责运行检索评估",
                "meta": "4 个来源"
              },
              {
                "text": "Carol 转到 ML 团队，负责微调排序器",
                "meta": "3 个来源"
              },
              {
                "text": "Alice 加入研究团队",
                "meta": "2 个来源",
                "mark": "new"
              }
            ],
            "mm": [
              {
                "tag": "研究",
                "tone": "blue",
                "text": "Bob：检索评估"
              },
              {
                "tag": "ML 团队",
                "tone": "purple",
                "text": "Carol：微调排序器"
              },
              {
                "text": "依据 2 条观测、1 条事实",
                "meta": "v1"
              }
            ]
          },
          "say": "记忆库持续学习；整合过程在该模型的范围内生成一条新观测。",
          "ms": 2800
        },
        {
          "edges": {
            "edge": "changed",
            "data": "比 v1 更新"
          },
          "show": {
            "trigger": [
              {
                "tag": "待更新",
                "tone": "orange",
                "text": "范围内有比 v1 上次读取的记忆更新的内容"
              }
            ]
          },
          "say": "触发器会先检查：该模型范围内是否有比上次刷新所读取的最新记忆更新的内容？记忆库其他范围内的活动不计入。",
          "ms": 3200
        },
        {
          "edges": {
            "edge": "refresh",
            "data": "刷新"
          },
          "show": {
            "reflect": [
              {
                "text": "仅读取 v1 之后新增的内容"
              }
            ]
          },
          "say": "在增量模式下，刷新只读取上次刷新之后进入记忆库的记忆。"
        },
        {
          "edges": {
            "edge": "read-src",
            "data": "新增内容"
          },
          "show": {
            "obs": [
              {
                "text": "Bob 负责运行检索评估",
                "meta": "4 个来源"
              },
              {
                "text": "Carol 转到 ML 团队，负责微调排序器",
                "meta": "3 个来源"
              },
              {
                "text": "Alice 加入研究团队",
                "meta": "2 个来源",
                "mark": "✓"
              }
            ]
          }
        },
        {
          "edges": [
            {
              "edge": "write",
              "data": "append_block → 研究"
            },
            {
              "edge": "version",
              "data": "v1"
            }
          ],
          "show": {
            "reflect": [
              {
                "tag": "编辑",
                "tone": "green",
                "text": "append_block",
                "meta": "研究",
                "mono": true
              }
            ],
            "mm": [
              {
                "tag": "研究",
                "tone": "blue",
                "text": "Bob：检索评估",
                "mark": "same"
              },
              {
                "tag": "研究",
                "tone": "blue",
                "text": "Alice：3 月加入",
                "mark": "added"
              },
              {
                "tag": "ML 团队",
                "tone": "purple",
                "text": "Carol：微调排序器",
                "mark": "same"
              },
              {
                "text": "证据：3 条观测、1 条事实",
                "meta": "v2"
              }
            ],
            "hist": [
              {
                "tag": "v1",
                "tone": "gray",
                "text": "Bob、Carol"
              }
            ]
          },
          "say": "它不会重写文档，而是应用编辑：在“研究”部分添加一个项目符号。其余内容原样保留，旧版本则存入历史记录。",
          "ms": 3800
        }
      ]
    },
    {
      "label": "读取",
      "caption": "",
      "beats": [
        {
          "edges": {
            "edge": "call",
            "data": "获取“团队概况”"
          },
          "show": {
            "app": [
              {
                "tag": "读取",
                "tone": "gray",
                "text": "团队概况"
              }
            ]
          },
          "say": "应用需要答案时，会按 ID 请求对应的模型。"
        },
        {
          "edges": {
            "edge": "read",
            "data": "数据库读取"
          },
          "say": "这只是一次数据库读取：无需检索、调用 LLM 或等待。"
        },
        {
          "edges": [
            {
              "edge": "read",
              "back": true,
              "data": "v2 · 最新"
            }
          ],
          "ms": 1600
        },
        {
          "edges": {
            "edge": "call",
            "back": true,
            "data": "文档"
          },
          "show": {
            "app": [
              {
                "tag": "读取",
                "tone": "gray",
                "text": "团队概况"
              },
              {
                "tag": "答案",
                "tone": "green",
                "text": "研究：Bob、Alice · ML：Carol",
                "meta": "最新",
                "mark": "✓"
              }
            ]
          },
          "say": "所有提问者都会得到同一份文档。Reflect 也会优先读取心智模型，并且只在其内容为最新时才信任它。",
          "ms": 3400
        }
      ]
    }
  ]
}
