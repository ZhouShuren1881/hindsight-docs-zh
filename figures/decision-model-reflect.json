        {
          "edges": {
            "edge": "reply",
            "data": "答案 + 引用"
          },
          "show": {
            "agent": [
              {
                "tag": "答案",
                "tone": "green",
                "text": "是：她懂 Python，喜欢研究；她还需要掌握 PyTorch。"
              }
            ]
          },
          "say": "总共两次 LLM 调用。如果决策模型失败，就像智能体模式一样由 LLM 决定何时停止。",
          "ms": 3200
        }
      ]
