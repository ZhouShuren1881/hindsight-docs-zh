{
  "title": "多策略检索（TEMPR）",
  "speed": 2200,
  "elements": [
    {
      "id": "agent",
      "type": "rectangle",
      "content": [
        {
          "type": "title",
          "text": "你的AI智能体"
        }
      ],
      "minCardHeight": 133,
      "width": 180
    },
    {
      "id": "semantic",
      "type": "rectangle",
      "content": [
        {
          "type": "title",
          "text": "语义"
        },
        {
          "type": "subtitle",
          "text": "意义"
        }
      ]
    },
    {
      "id": "keyword",
      "type": "rectangle",
      "content": [
        {
          "type": "title",
          "text": "关键字"
        },
        {
          "type": "subtitle",
          "text": "精确单词 (BM25)"
        }
      ]
    },
    {
      "id": "graph",
      "type": "rectangle",
      "content": [
        {
          "type": "title",
          "text": "图"
        },
        {
          "type": "subtitle",
          "text": "通过实体"
        }
      ]
    },
    {
      "id": "temporal",
      "type": "rectangle",
      "content": [
        {
          "type": "title",
          "text": "时间"
        },
        {
          "type": "subtitle",
          "text": "按时间"
        }
      ]
    },
    {
      "id": "recall",
      "type": "group",
      "label": {
        "title": "记忆召回·4臂并联"
      },
      "children": [
        "semantic",
        "keyword",
        "graph",
        "temporal"
      ],
      "layout": {
        "direction": "column",
        "gap": 10,
        "align": "stretch"
      }
    },
    {
      "id": "vectors",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "向量"
        }
      ],
      "minCardHeight": 28
    },
    {
      "id": "fulltext",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "全文"
        }
      ],
      "minCardHeight": 28
    },
    {
      "id": "egraph",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "实体图"
        }
      ],
      "minCardHeight": 73
    },
    {
      "id": "time",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "日期"
        }
      ],
      "minCardHeight": 28
    },
    {
      "id": "indexes",
      "type": "group",
      "label": {
        "title": "索引"
      },
      "children": [
        "vectors",
        "fulltext",
        "egraph",
        "time"
      ],
      "layout": {
        "direction": "column",
        "gap": 10,
        "align": "stretch"
      }
    },
    {
      "id": "units",
      "type": "cylinder",
      "content": [
        {
          "type": "title",
          "text": "记忆"
        },
        {
          "type": "subtitle",
          "text": "世界事实 · 经验事实 · 观察"
        }
      ],
      "minCardHeight": 193,
      "width": 196
    },
    {
      "id": "rrf",
      "type": "rectangle",
      "content": [
        {
          "type": "title",
          "text": "RRF融合"
        },
        {
          "type": "subtitle",
          "text": "Σ 1 / (60 + rank)"
        }
      ],
      "minCardHeight": 73,
      "width": 196
    },
    {
      "id": "rerank",
      "type": "rectangle",
      "content": [
        {
          "type": "title",
          "text": "交叉编码器"
        },
        {
          "type": "subtitle",
          "text": "阅读查询+记忆"
        }
      ],
      "minCardHeight": 73,
      "width": 196
    },
    {
      "id": "boosts",
      "type": "rectangle",
      "content": [
        {
          "type": "title",
          "text": "提升"
        },
        {
          "type": "subtitle",
          "text": "近期 · 时间 · 证据"
        }
      ],
      "minCardHeight": 73,
      "width": 196
    },
    {
      "id": "budget",
      "type": "rectangle",
      "content": [
        {
          "type": "title",
          "text": "token 预算"
        },
        {
          "type": "subtitle",
          "text": "max_tokens"
        }
      ],
      "minCardHeight": 73,
      "width": 196
    },
    {
      "id": "ranking",
      "type": "group",
      "label": {
        "title": "排名"
      },
      "children": [
        "rrf",
        "rerank",
        "boosts",
        "budget"
      ],
      "layout": {
        "direction": "column",
        "gap": 24,
        "align": "stretch"
      }
    },
    {
      "id": "g0",
      "type": "group",
      "children": [
        "agent",
        "recall",
        "indexes",
        "units",
        "ranking"
      ],
      "layout": {
        "direction": "row",
        "gap": 32,
        "align": "center"
      }
    },
    {
      "id": "call",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "agent"
      },
      "end": {
        "id": "recall"
      },
      "label": {
        "text": "recall()"
      }
    },
    {
      "id": "s-idx",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "semantic"
      },
      "end": {
        "id": "vectors"
      }
    },
    {
      "id": "k-idx",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "keyword"
      },
      "end": {
        "id": "fulltext"
      }
    },
    {
      "id": "g-idx",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "graph"
      },
      "end": {
        "id": "egraph"
      }
    },
    {
      "id": "t-idx",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "temporal"
      },
      "end": {
        "id": "time"
      }
    },
    {
      "id": "lookup",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "indexes"
      },
      "end": {
        "id": "units"
      },
      "label": {
        "text": "指向"
      }
    },
    {
      "id": "lists",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "units"
      },
      "end": {
        "id": "rrf"
      },
      "label": {
        "text": "4 个排序列表"
      }
    },
    {
      "id": "rrf->rerank",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "rrf"
      },
      "end": {
        "id": "rerank"
      }
    },
    {
      "id": "rerank->boosts",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "rerank"
      },
      "end": {
        "id": "boosts"
      }
    },
    {
      "id": "boosts->budget",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "boosts"
      },
      "end": {
        "id": "budget"
      }
    },
    {
      "id": "results",
      "type": "arrow",
      "route": "curved",
      "start": {
        "id": "budget"
      },
      "end": {
        "id": "agent"
      },
      "quiet": true,
      "around": "below"
    }
  ],
  "scenes": [
