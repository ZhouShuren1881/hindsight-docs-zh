          "type": "subtitle",
          "text": "按含义"
        }
      ]
    },
    {
      "id": "keyword",
      "type": "rectangle",
      "content": [
        {
          "type": "title",
          "text": "关键词检索"
        },
        {
          "type": "subtitle",
          "text": "精确词语（BM25）"
        }
      ]
    },
    {
      "id": "graph",
