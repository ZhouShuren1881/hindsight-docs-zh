{
  "templates": [
    {
      "id": "conversation",
      "name": "对话",
      "description": "适用于聊天智能体和助手。跟踪用户偏好与对话模式，并逐步构建用户画像。",
      "category": "chat",
      "integrations": [
        "litellm",
        "langgraph",
        "pydantic-ai",
        "vercel-ai-sdk",
        "vercel-chat",
        "crewai",
        "ag2",
        "agno",
        "strands",
        "llamaindex",
        "local-mcp",
        "skills",
        "hermes"
      ],
      "manifest_file": "templates/conversation.json"
    },
    {
      "id": "coding-agent",
      "name": "编程智能体",
      "description": "适用于编程助手和智能体。跨会话记住项目架构、技术决策、编程模式、评审偏好与工作流。采用较高的字面解读倾向，以便准确召回技术信息。",
      "category": "coding",
      "integrations": [
        "claude-code",
        "codex",
        "hermes"
      ],
      "manifest_file": "templates/coding-agent.json"
    },
    {
      "id": "personal-assistant",
      "name": "个人助手",
      "description": "适用于持续运行的个人助手，可管理任务、记住偏好，并在日常生活中保持上下文。跟踪承诺、日常习惯与个人背景。",
      "category": "assistant",
      "integrations": [
        "openclaw",
        "hermes",
        "nemoclaw",
        "hindclaw"
      ],
      "manifest_file": "templates/personal-assistant.json"
    },
    {
      "id": "business-executive",
      "name": "企业高管",
      "description": "适用于根据会议记录跟踪客户、销售机会、项目交付和产品开发的高管与运营人员。提取决策、承诺、负责人和状态变化，并构建销售管道、交付、产品及关系心智模型。采用较高的字面解读倾向，以准确召回数字、日期和承诺。",
      "category": "business",
      "integrations": [
        "hermes",
        "openclaw",
        "langgraph",
        "crewai",
        "pydantic-ai",
        "local-mcp"
      ],
      "manifest_file": "templates/business-executive.json"
    },
    {
      "id": "hermes-gateway-bot",
      "name": "网关 / 社区机器人",
      "description": "适用于通过多个聊天平台（Telegram、Discord、Slack）与多人交流的智能体。分别维护每个人的画像，学习各个社区的规范，并跨用户跟踪未结事项。",
      "category": "chat",
      "integrations": [
        "langgraph",
        "crewai",
        "agno",
        "hermes"
      ],
      "manifest_file": "templates/hermes-gateway-bot.json"
    },
    {
      "id": "hermes-orchestrator",
      "name": "多智能体编排器",
      "description": "适用于专业智能体编排。记住决策及其理由、职责边界、交接，以及以往升级事件的处理结果。采用较高的字面解读倾向和怀疑倾向，以便精确协调。",
      "category": "orchestration",
      "integrations": [
        "langgraph",
        "crewai",
        "autogen",
        "hermes"
      ],
      "manifest_file": "templates/hermes-orchestrator.json"
    },
    {
      "id": "customer-support",
      "name": "客户支持智能体",
      "description": "适用于客服和客户沟通智能体。记住客户问题、解决方案、情绪与账户背景，让每次互动都有充分的上下文。具备较高的共情倾向，绝不重复询问已知信息。",
      "category": "support",
      "integrations": [
        "langgraph",
        "crewai",
        "dify",
        "hermes"
      ],
      "manifest_file": "templates/customer-support.json"
    },
    {
      "id": "research-assistant",
      "name": "研究助手",
      "description": "适用于研究、监测和知识工作智能体，可撰写简报和内容摘要，或维护第二大脑。了解用户的兴趣，跟踪应忽略的内容以优化筛选，并逐步积累带有来源的持久知识。",
      "category": "research",
      "integrations": [
        "obsidian",
        "llamaindex",
        "langgraph",
        "hermes"
      ],
      "manifest_file": "templates/research-assistant.json"
    },
    {
      "id": "plain-retrieval",
      "name": "纯检索",
      "description": "将 Hindsight 用作传统向量存储：输入文本分块，输出混合检索结果；存入和召回时均不调用 LLM。以舍弃事实、实体、图结构和时间结构为代价，换取最低成本和延迟。",
      "category": "retrieval",
      "integrations": [
        "litellm",
        "langgraph",
        "pydantic-ai",
        "ai-sdk",
        "llamaindex",
        "local-mcp"
      ],
      "manifest_file": "templates/plain-retrieval.json"
    }
  ]
}
