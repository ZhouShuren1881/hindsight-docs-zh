# 解析参数
APP=""
declare -a ENV_VARS=()

while [[ $# -gt 0 ]]; do
    case $1 in
        --app)
            APP="$2"
            shift 2
            ;;
        --set)
            ENV_VARS+=("$2")
            shift 2
            ;;
        -h|--help)
            echo "用法：$0 --app <app> --set ENV=VALUE [--set ENV2=VALUE2 ...]"
            echo ""
            echo "选项："
            echo "  --app              必填。目标应用（目前仅支持 claude-desktop）"
            echo "  --set ENV=VALUE    设置环境变量（可重复指定）"
            echo ""
            echo "示例："
            echo "  # 使用 OpenAI"
            echo "  $0 --app claude-desktop --set HINDSIGHT_API_LLM_API_KEY=sk-..."
            echo ""
            echo "  # 使用 Ollama（本地 LLM，无需 API 密钥）"
            echo "  $0 --app claude-desktop --set HINDSIGHT_API_LLM_PROVIDER=ollama --set HINDSIGHT_API_LLM_MODEL=llama3.2"
            exit 0
            ;;
        *)
            print_error "未知选项：$1。使用 --help 查看用法。"
            ;;
    esac
done

# 校验必填参数
if [ -z "$APP" ]; then
    print_error "缺少必填参数 --app。使用 --help 查看用法。"
fi

if [ "$APP" != "claude-desktop" ]; then
    print_error "不支持的应用：$APP。目前仅支持 'claude-desktop'。"
fi

# 检测操作系统
detect_os() {
    case "$(uname -s)" in
        Darwin*)    echo "macos" ;;
        Linux*)     echo "linux" ;;
        MINGW*|MSYS*|CYGWIN*) echo "windows" ;;
        *)          echo "unknown" ;;
    esac
}

OS=$(detect_os)

# 根据操作系统获取 Claude Desktop 配置路径
get_claude_config_path() {
    case "$OS" in
        macos)
            echo "$HOME/Library/Application Support/Claude/claude_desktop_config.json"
            ;;
        linux)
            echo "$HOME/.config/Claude/claude_desktop_config.json"
            ;;
        windows)
            echo "$APPDATA/Claude/claude_desktop_config.json"
            ;;
        *)
            print_error "不支持的操作系统：$OS"
            ;;
    esac
}

# 检查是否已安装 uvx，并返回其路径
find_uvx() {
    # 检查是否位于 PATH 中
    if command -v uvx &> /dev/null; then
        command -v uvx
        return 0
    fi

    # 检查常用安装路径
    local paths=(
        "$HOME/.local/bin/uvx"
        "$HOME/.cargo/bin/uvx"
        "/usr/local/bin/uvx"
    )

    for path in "${paths[@]}"; do
        if [ -f "$path" ]; then
            echo "$path"
            return 0
        fi
    done

    return 1
}

# 安装 uv（包含 uvx）
install_uv() {
    print_info "正在安装 uv……"

    if [ "$OS" = "windows" ]; then
        powershell -ExecutionPolicy ByPass -c "irm https://astral.sh/uv/install.ps1 | iex"
    else
        curl -LsSf https://astral.sh/uv/install.sh | sh
    fi

    # 加载环境配置，使 uvx 可通过 PATH 访问
    if [ -f "$HOME/.local/bin/env" ]; then
        source "$HOME/.local/bin/env"
    fi

    # 再次查找 uvx
    if ! UVX_PATH=$(find_uvx); then
        print_error "uv 已安装，但未找到 uvx。请检查安装情况。"
    fi

    print_success "uv 安装成功"
}

# 更新 Claude Desktop 配置
update_claude_config() {
    local config_path="$1"
    local uvx_path="$2"
    shift 2
    local env_vars=("$@")

    # 配置目录不存在时创建目录
    mkdir -p "$(dirname "$config_path")"

    # 检查 jq 是否可用（新建和更新配置均需要 jq）
    if ! command -v jq &> /dev/null; then
        print_warning "未找到 jq，正在安装……"
        if [ "$OS" = "macos" ]; then
            if command -v brew &> /dev/null; then
                brew install jq
            else
                print_error "请安装 jq：brew install jq"
            fi
        elif [ "$OS" = "linux" ]; then
            if command -v apt-get &> /dev/null; then
                sudo apt-get install -y jq
            elif command -v yum &> /dev/null; then
                sudo yum install -y jq
            else
                print_error "请手动安装 jq"
            fi
        fi
    fi

    # 根据 env_vars 数组构建 env 对象
    local env_json="{}"
    for env_var in "${env_vars[@]}"; do
        local key="${env_var%%=*}"
        local value="${env_var#*=}"
        env_json=$(echo "$env_json" | jq --arg k "$key" --arg v "$value" '. + {($k): $v}')
    done

    # 构建 hindsight 服务器配置
    local hindsight_config
    hindsight_config=$(jq -n \
        --arg uvx "$uvx_path" \
        --argjson env "$env_json" \
        '{
            "command": $uvx,
            "args": ["--from", "hindsight-api", "hindsight-local-mcp"],
            "env": $env
        }')

    # 检查配置文件是否存在且非空
    if [ -f "$config_path" ] && [ -s "$config_path" ]; then
        print_info "正在更新已有的 Claude Desktop 配置……"

        # 备份已有配置
        cp "$config_path" "${config_path}.backup"
        print_info "已有配置已备份到 ${config_path}.backup"

        # 在已有配置中添加或更新 hindsight 服务器
        local new_config
        new_config=$(jq --argjson hs "$hindsight_config" '.mcpServers.hindsight = $hs' "$config_path")

        echo "$new_config" > "$config_path"
    else
        print_info "正在创建新的 Claude Desktop 配置……"

        # 创建包含 hindsight 服务器的新配置
        local new_config
        new_config=$(jq -n --argjson hs "$hindsight_config" '{"mcpServers": {"hindsight": $hs}}')
        echo "$new_config" > "$config_path"
    fi

    print_success "Claude Desktop 配置已更新：$config_path"
}

# 主安装流程
main() {
    print_banner

    print_info "应用：$APP"
    if [ ${#ENV_VARS[@]} -gt 0 ]; then
        print_info "已配置 ${#ENV_VARS[@]} 个环境变量"
    fi
    echo ""

    # 第 1 步：检查或安装 uvx
    print_info "正在检查 uvx……"
    if UVX_PATH=$(find_uvx); then
        print_success "已找到 uvx：$UVX_PATH"
    else
        print_warning "未找到 uvx，正在安装 uv……"
        install_uv
        UVX_PATH=$(find_uvx)
    fi

    # 第 2 步：更新 Claude Desktop 配置
    CONFIG_PATH=$(get_claude_config_path)
    print_info "正在配置 Claude Desktop……"
    update_claude_config "$CONFIG_PATH" "$UVX_PATH" "${ENV_VARS[@]}"

    # 完成！
    echo ""
    print_success "安装完成！"
    echo ""
    print_info "接下来："
    echo "  1. 重启 Claude Desktop"
    echo "  2. 在 Claude 中找到 'hindsight' 工具（retain、recall）"
    echo ""
}

main "$@"
