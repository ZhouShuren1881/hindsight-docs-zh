# 获取应用的技能目录（兼容 bash 3.x）
get_skills_dir() {
    case "$1" in
        claude)   echo "$HOME/.claude/skills" ;;
        opencode) echo "$HOME/.opencode/skills" ;;
        codex)    echo "$HOME/.codex/skills" ;;
        *)        echo "" ;;
    esac
}

# 获取应用显示名称（兼容 bash 3.x）
get_app_name() {
    case "$1" in
        claude)   echo "Claude Code" ;;
        opencode) echo "OpenCode" ;;
        codex)    echo "Codex CLI" ;;
        *)        echo "$1" ;;
    esac
}

# 解析参数
APP=""
MODE=""

show_usage() {
    echo "用法：$0 [--app <app>] [--mode <mode>]"
    echo ""
    echo "选项："
    echo "  --app <app>      目标应用：claude、opencode、codex"
    echo "  --mode <mode>    模式：local（默认）或 cloud"
    echo ""
    echo "示例："
    echo "  $0 --app claude"
    echo "  $0 --app claude --mode cloud"
    exit 1
}

while [[ $# -gt 0 ]]; do
    case $1 in
        --app)
            APP="$2"
            shift 2
            ;;
        --mode)
            MODE="$2"
            shift 2
            ;;
        --help|-h)
            show_usage
            ;;
        *)
            print_error "未知选项：$1"
            ;;
    esac
done

# 显示横幅
print_banner

# 校验 app 参数
if [ -z "$APP" ]; then
    # 检查是否有终端可用于交互式提示
    if [ -t 0 ] || [ -e /dev/tty ]; then
        echo -e "${DIM}选择 AI 编码助手：${NC}"
        echo ""
        echo -e "  ${BOLD}1)${NC} Claude Code"
        echo -e "  ${BOLD}2)${NC} OpenCode"
        echo -e "  ${BOLD}3)${NC} Codex CLI"
        echo ""
        # 标准输入来自管道时，通过 /dev/tty 读取输入
        if [ -t 0 ]; then
            read -p "输入选项 [1]：" app_choice
        else
            read -p "输入选项 [1]：" app_choice </dev/tty
        fi
        app_choice=${app_choice:-1}

        case $app_choice in
            1) APP="claude" ;;
            2) APP="opencode" ;;
            3) APP="codex" ;;
            *) APP="claude" ;;
        esac
        echo ""
    else
        # 非交互模式（CI）下默认使用 claude
        APP="claude"
        print_info "检测到非交互模式，默认使用 Claude Code"
    fi
fi

# 获取所选应用的技能目录
SKILLS_DIR=$(get_skills_dir "$APP")
APP_NAME=$(get_app_name "$APP")
if [ -z "$SKILLS_DIR" ]; then
    print_error "未知应用 '$APP'。支持：claude、opencode、codex"
fi

print_info "正在为 ${BOLD}$APP_NAME${NC} 安装"

# 选择模式（本地或云端）
if [ -z "$MODE" ]; then
    if [ -t 0 ] || [ -e /dev/tty ]; then
        echo ""
        echo -e "${DIM}选择部署模式：${NC}"
        echo ""
        echo -e "  ${BOLD}1)${NC} 本地 ${DIM}- 在本机运行 Hindsight（默认）${NC}"
        echo -e "  ${BOLD}2)${NC} 云端 ${DIM}- 连接 Hindsight Cloud（适用于团队）${NC}"
        echo ""
        if [ -t 0 ]; then
            read -p "输入选项 [1]：" mode_choice
        else
            read -p "输入选项 [1]：" mode_choice </dev/tty
        fi
        mode_choice=${mode_choice:-1}

        case $mode_choice in
            1) MODE="local" ;;
            2) MODE="cloud" ;;
            *) MODE="local" ;;
        esac
        echo ""
    else
        MODE="local"
        print_info "检测到非交互模式，默认使用 local"
    fi
fi

# 校验模式
if [ "$MODE" != "local" ] && [ "$MODE" != "cloud" ]; then
    print_error "未知模式 '$MODE'。支持：local、cloud"
fi

print_info "模式：${BOLD}$MODE${NC}"

# 第 1 步：检查 Python 或 uvx
print_step "正在检查前置条件"

if ! command -v python3 &> /dev/null && ! command -v uvx &> /dev/null; then
    print_error "需要 Python 3 或 uvx。\n请从 https://python.org 或 https://docs.astral.sh/uv/ 安装"
fi
print_success "Python/uvx 可用"

# 根据模式选择配置方式
if [ "$MODE" = "local" ]; then
    # 本地模式：通过 hindsight-embed 配置 LLM 提供商
    print_step "正在配置 LLM 提供商"

    # 安装或运行 hindsight-embed configure
    # 从 /dev/tty 重定向标准输入，避免“不是终端”的警告
    if command -v uvx &> /dev/null; then
        uvx hindsight-embed configure </dev/tty
    else
        pip install -q hindsight-embed
        hindsight-embed configure </dev/tty
    fi

    # 安装本地技能
    print_step "正在向 $APP_NAME 安装技能"

    mkdir -p "$SKILLS_DIR/hindsight"
    echo "$SKILL_CONTENT_LOCAL" > "$SKILLS_DIR/hindsight/SKILL.md"
    print_success "已安装到 $SKILLS_DIR/hindsight/"

    # 本地模式安装完成！
    echo ""
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${GREEN}  ✓ 安装完成！${NC}"
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo -e "  Hindsight 技能已可在 ${BOLD}$APP_NAME${NC} 中使用。"
    echo ""
    echo -e "  ${DIM}测试 CLI：${NC}"
    echo -e "    ${CYAN}uvx hindsight-embed memory retain default \"Alice 在 Google 担任软件工程师\"${NC}"
    echo -e "    ${CYAN}uvx hindsight-embed memory recall default \"Alice\"${NC}"
    echo ""
    echo -e "  ${DIM}$APP_NAME 会在适用时自动使用该技能。${NC}"
    echo ""
    echo -e "  ${DIM}文档：${NC} ${BLUE}https://hindsight.vectorize.io${NC}"
    echo ""

else
    # 云端模式：安装 CLI 并配置 Hindsight Cloud 连接
    print_step "正在安装 Hindsight CLI"

    # 下载并安装 CLI 二进制文件
    curl -fsSL https://hindsight.vectorize.io/get-cli | bash

    print_step "正在配置 Hindsight Cloud 连接"

    DEFAULT_CLOUD_URL="https://api.hindsight.vectorize.io"

    echo -e "${DIM}输入 Hindsight Cloud 连接信息。${NC}"
    echo -e "${DIM}可从团队管理员或 https://ui.hindsight.vectorize.io 获取这些信息${NC}"
    echo ""

    # 提示输入云端 URL
    if [ -t 0 ]; then
        read -p "云端 API URL [$DEFAULT_CLOUD_URL]：" CLOUD_URL
    else
        read -p "云端 API URL [$DEFAULT_CLOUD_URL]：" CLOUD_URL </dev/tty
    fi
    CLOUD_URL=${CLOUD_URL:-$DEFAULT_CLOUD_URL}

    # 提示输入 API 密钥
    if [ -t 0 ]; then
        read -p "API 密钥：" CLOUD_API_KEY
    else
        read -p "API 密钥：" CLOUD_API_KEY </dev/tty
    fi
    if [ -z "$CLOUD_API_KEY" ]; then
        print_error "云端模式需要 API 密钥"
    fi

    # 提示输入记忆库 ID
    if [ -t 0 ]; then
        read -p "记忆库 ID（例如 team-myproject）：" CLOUD_BANK_ID
    else
        read -p "记忆库 ID（例如 team-myproject）：" CLOUD_BANK_ID </dev/tty
    fi
    if [ -z "$CLOUD_BANK_ID" ]; then
        print_error "云端模式需要记忆库 ID"
    fi

    # 将配置保存到 ~/.hindsight/config
    print_step "正在保存配置"

    HINDSIGHT_CONFIG_DIR="$HOME/.hindsight"
    HINDSIGHT_CONFIG_FILE="$HINDSIGHT_CONFIG_DIR/config"

    mkdir -p "$HINDSIGHT_CONFIG_DIR"

    # 写入配置文件（hindsight-cli 使用的 TOML 格式）
    cat > "$HINDSIGHT_CONFIG_FILE" << EOF
api_url = "$CLOUD_URL"
api_key = "$CLOUD_API_KEY"
EOF

    # 限制配置文件的访问权限（其中包含 API 密钥）
    chmod 600 "$HINDSIGHT_CONFIG_FILE"

    print_success "已保存到 $HINDSIGHT_CONFIG_FILE"

    # 替换记忆库 ID 后安装云端技能
    print_step "正在向 $APP_NAME 安装技能"

    mkdir -p "$SKILLS_DIR/hindsight"

    # 将 BANK_ID 替换为实际记忆库 ID
    SKILL_CONTENT_CLOUD=$(echo "$SKILL_CONTENT_CLOUD_TEMPLATE" | sed "s/BANK_ID/$CLOUD_BANK_ID/g")
    echo "$SKILL_CONTENT_CLOUD" > "$SKILLS_DIR/hindsight/SKILL.md"
    print_success "已安装到 $SKILLS_DIR/hindsight/"

    # 云端模式安装完成！
    echo ""
