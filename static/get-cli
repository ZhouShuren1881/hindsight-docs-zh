# 检测平台
detect_platform() {
    local os=$(uname -s)
    local arch=$(uname -m)

    case "$os" in
        Darwin)
            if [[ "$arch" == "arm64" ]] || [[ "$arch" == "aarch64" ]]; then
                echo "darwin-arm64"
            elif [[ "$arch" == "x86_64" ]]; then
                echo "darwin-amd64"
            else
                print_error "不支持的 macOS 架构：$arch"
                exit 1
            fi
            ;;
        Linux)
            if [[ "$arch" == "x86_64" ]]; then
                echo "linux-amd64"
            elif [[ "$arch" == "aarch64" ]] || [[ "$arch" == "arm64" ]]; then
                echo "linux-arm64"
            else
                print_error "不支持的 Linux 架构：$arch"
                exit 1
            fi
            ;;
        *)
            print_error "不支持的操作系统：$os"
            exit 1
            ;;
    esac
}

# 从 GitHub API 获取最新版本
get_latest_version() {
    local api_url="https://api.github.com/repos/vectorize-io/hindsight/releases/latest"
    local version=""

    if command -v curl > /dev/null 2>&1; then
        version=$(curl -fsSL "$api_url" | grep '"tag_name":' | sed -E 's/.*"tag_name": *"([^"]+)".*/\1/')
    elif command -v wget > /dev/null 2>&1; then
        version=$(wget -qO- "$api_url" | grep '"tag_name":' | sed -E 's/.*"tag_name": *"([^"]+)".*/\1/')
    fi

    if [[ -z "$version" ]]; then
        print_error "无法从 GitHub 获取最新版本" >&2
        exit 1
    fi

    echo "$version"
}

# 下载二进制文件
download_binary() {
    local platform=$1
    local version=$2
    local download_url="${REPO_URL}/releases/download/${version}/hindsight-${platform}"
    local tmp_file="/tmp/hindsight-$$"

    print_info "正在下载适用于 $platform 的 Hindsight CLI ${version}……" >&2

    if command -v curl > /dev/null 2>&1; then
        # GitHub 返回指向 Azure Blob Storage 的 302 重定向
        # curl -L 有时会收到 503 错误，因此手动处理重定向
        local redirect_url=$(curl -sI "$download_url" 2>/dev/null | grep -i "^location:" | sed 's/location: //i' | tr -d '\r\n')
        if [[ -n "$redirect_url" ]]; then
            curl -fsSL "$redirect_url" -o "$tmp_file"
        else
            # 没有重定向时改为直接下载
            curl -fsSL "$download_url" -o "$tmp_file"
        fi
    elif command -v wget > /dev/null 2>&1; then
        wget -q "$download_url" -O "$tmp_file"
    else
        print_error "未找到 curl 或 wget，请安装其中之一。" >&2
        exit 1
    fi

    echo "$tmp_file"
}

# 安装二进制文件
install_binary() {
    local tmp_file=$1

    # 安装目录不存在时创建目录
    mkdir -p "$INSTALL_DIR"

    # 将二进制文件移动到安装目录
    mv "$tmp_file" "$INSTALL_DIR/$BINARY_NAME"
    chmod +x "$INSTALL_DIR/$BINARY_NAME"

    print_success "已安装到：$INSTALL_DIR/$BINARY_NAME"
}

# 检查目录是否位于 PATH 中
check_path() {
    if [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
        print_warning "$INSTALL_DIR 不在 PATH 中"
        echo ""
        echo "将以下命令添加到 shell 配置文件，以把该目录加入 PATH："
        echo ""

        # 检测 shell
        if [[ -n "$BASH_VERSION" ]]; then
            echo "  echo 'export PATH=\"$INSTALL_DIR:\$PATH\"' >> ~/.bashrc"
            echo "  source ~/.bashrc"
        elif [[ -n "$ZSH_VERSION" ]]; then
            echo "  echo 'export PATH=\"$INSTALL_DIR:\$PATH\"' >> ~/.zshrc"
            echo "  source ~/.zshrc"
        else
            echo "  export PATH=\"$INSTALL_DIR:\$PATH\""
        fi
        echo ""
    fi
}

# 主安装流程
main() {
    print_banner

    # 检测平台
    platform=$(detect_platform)
    print_info "检测到的平台：$platform"

    # 获取版本（使用环境变量指定的版本或最新版本）
    if [[ -n "$HINDSIGHT_CLI_VERSION" ]]; then
        version="$HINDSIGHT_CLI_VERSION"
        # 未带 v 前缀时添加该前缀（GitHub 发布版本使用 v 前缀）
        if [[ ! "$version" =~ ^v ]]; then
            version="v${version}"
        fi
        print_info "使用指定版本：$version"
    else
        version=$(get_latest_version)
        print_info "最新版本：$version"
    fi

    # 下载二进制文件
    tmp_file=$(download_binary "$platform" "$version")

    # 安装二进制文件
    install_binary "$tmp_file"

    # 检查 PATH
    check_path

    print_success "安装完成！"
    echo ""
    print_info "试用：$BINARY_NAME --help"
    echo ""
    print_info "配置 API URL："
    echo "  export HINDSIGHT_API_URL=http://localhost:8888"
    echo ""
}

# 执行安装
main
