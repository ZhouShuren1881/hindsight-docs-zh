#!/bin/bash
#
# 为 OpenAI Codex CLI 安装 Hindsight 记忆功能
#
# 用法：
#   curl -fsSL https://hindsight.vectorize.io/get-codex | bash
#
# 选项：
#   --uninstall    移除 Hindsight 钩子
#   --mode <mode>  模式：local（默认）或 cloud
#
# 示例：
#   curl -fsSL https://hindsight.vectorize.io/get-codex | bash
#   curl -fsSL https://hindsight.vectorize.io/get-codex | bash -s -- --mode cloud
#   curl -fsSL https://hindsight.vectorize.io/get-codex | bash -s -- --uninstall
#

set -e

# 输出颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m' # 重置颜色

print_info() {
    echo -e "${BLUE}ℹ${NC} $1"
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
    exit 1
}

print_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

print_step() {
    echo ""
    echo -e "${BOLD}${CYAN}▸ $1${NC}"
    echo ""
}

print_banner() {
    echo ""
    # ANSI 标志
    echo -e "  \033[38;2;9;127;184m▄\033[0m\033[48;2;8;130;178m\033[38;2;5;133;186m▄\033[0m       \033[48;2;10;143;160m\033[38;2;10;143;165m▄\033[0m\033[38;2;7;140;156m▄\033[0m  "
    echo -e " \033[38;2;8;125;192m▄\033[0m \033[38;2;3;132;191m▀\033[0m\033[38;2;2;133;192m▄\033[0m \033[38;2;3;132;180m▄\033[0m\033[38;2;1;137;184m▄\033[0m\033[38;2;3;133;174m▄\033[0m \033[38;2;3;142;176m▄\033[0m\033[38;2;4;142;169m▀\033[0m \033[38;2;10;144;164m▄\033[0m "
    echo -e "\033[38;2;6;121;195m▀\033[0m\033[38;2;5;128;203m▀\033[0m\033[48;2;5;124;195m\033[38;2;3;125;200m▄\033[0m\033[38;2;2;126;196m▄\033[0m\033[48;2;3;128;188m\033[38;2;1;131;196m▄\033[0m\033[48;2;0;152;219m\033[38;2;2;131;191m▄\033[0m\033[38;2;1;141;196m▀\033[0m\033[38;2;1;135;183m▀\033[0m\033[38;2;1;148;198m▀\033[0m\033[48;2;1;156;202m\033[38;2;2;135;180m▄\033[0m\033[48;2;4;134;169m\033[38;2;1;137;177m▄\033[0m\033[38;2;3;138;173m▄\033[0m\033[48;2;6;137;165m\033[38;2;2;140;170m▄\033[0m\033[38;2;7;144;169m▀\033[0m\033[38;2;7;139;158m▀\033[0m"
    echo -e "   \033[48;2;2;128;202m\033[38;2;2;124;201m▄\033[0m\033[48;2;1;130;201m\033[38;2;0;135;212m▄\033[0m\033[38;2;2;128;196m▄\033[0m \033[48;2;2;142;204m\033[38;2;7;138;199m▄\033[0m \033[38;2;1;135;186m▄\033[0m\033[48;2;1;142;186m\033[38;2;2;144;194m▄\033[0m\033[48;2;3;138;176m\033[38;2;2;134;176m▄\033[0m   "
    echo -e " \033[48;2;8;118;200m\033[38;2;8;121;209m▄\033[0m\033[38;2;3;121;203m▀\033[0m \033[38;2;3;122;192m▀\033[0m\033[38;2;1;138;216m▀\033[0m\033[48;2;0;138;210m\033[38;2;3;128;198m▄\033[0m\033[48;2;0;126;188m\033[38;2;2;131;198m▄\033[0m\033[48;2;0;142;205m\033[38;2;3;132;193m▄\033[0m\033[38;2;1;140;196m▀\033[0m  \033[38;2;4;134;175m▀\033[0m\033[48;2;13;135;167m\033[38;2;8;136;174m▄\033[0m "
    echo ""
    echo -e "  ${BOLD}HINDSIGHT 的 Codex CLI 集成${NC}"
    echo -e "  ${DIM}为 Codex 智能体提供持久记忆${NC}"
    echo ""
    echo -e "  ${YELLOW}已停用：${NC} 此安装器不再维护。请改用 Coding Agents 插件："
    echo -e "    ${CYAN}npx @vectorize-io/hindsight-coding-agents install codex --import-conversations${NC}"
    echo ""
}

# 已停用：Codex 钩子已由 Coding Agents 插件取代，源码也已从 main 删除。
# 因此安装和卸载均固定使用删除前最后一个版本的提交。
GITHUB_RAW="https://raw.githubusercontent.com/vectorize-io/hindsight/8674354f35adb1249c6d80cc1359aab8078858c4/hindsight-integrations/codex"
INSTALL_DIR="${HOME}/.hindsight/codex"
SCRIPTS_DIR="${INSTALL_DIR}/scripts"
CODEX_DIR="${HOME}/.codex"
HOOKS_FILE="${CODEX_DIR}/hooks.json"
CONFIG_FILE="${CODEX_DIR}/config.toml"

# 要下载的脚本文件
SCRIPT_FILES=(
    "scripts/session_start.py"
    "scripts/recall.py"
    "scripts/retain.py"
    "scripts/lib/__init__.py"
    "scripts/lib/bank.py"
    "scripts/lib/client.py"
    "scripts/lib/config.py"
    "scripts/lib/content.py"
    "scripts/lib/daemon.py"
    "scripts/lib/llm.py"
    "scripts/lib/state.py"
)

# 解析参数
MODE=""
UNINSTALL=false

while [[ $# -gt 0 ]]; do
    case $1 in
        --uninstall)
            UNINSTALL=true
            shift
            ;;
        --mode)
            MODE="$2"
            shift 2
            ;;
        --help|-h)
            echo "用法：curl -fsSL https://hindsight.vectorize.io/get-codex | bash [-s -- OPTIONS]"
            echo ""
            echo "选项："
            echo "  --mode <mode>    模式：local（默认）或 cloud"
            echo "  --uninstall      移除 Hindsight 钩子"
            exit 0
            ;;
        *)
            print_error "未知选项：$1"
            ;;
    esac
done

# ──────────────────────────────────────────────────────────────────────────────
# 卸载
# ──────────────────────────────────────────────────────────────────────────────
if [ "$UNINSTALL" = true ]; then
    echo "正在卸载 Hindsight Codex 集成……"

    if [ -d "${SCRIPTS_DIR}" ]; then
        rm -rf "${SCRIPTS_DIR}"
        echo "  已移除 ${SCRIPTS_DIR}"
    fi

    if [ -f "${HOOKS_FILE}" ]; then
        rm -f "${HOOKS_FILE}"
        echo "  已移除 ${HOOKS_FILE}"
    fi

    if [ -f "${CONFIG_FILE}" ]; then
        sed -i.bak '/^codex_hooks *= *true/d' "${CONFIG_FILE}" && rm -f "${CONFIG_FILE}.bak"
        echo "  已从 ${CONFIG_FILE} 移除 codex_hooks"
    fi

    echo ""
    print_success "卸载完成。"
    exit 0
fi

# ──────────────────────────────────────────────────────────────────────────────
# 安装
# ──────────────────────────────────────────────────────────────────────────────

print_banner

# 第 1 步：检查前置条件
print_step "正在检查前置条件"

if ! command -v python3 &> /dev/null; then
    print_error "需要 Python 3。\n请从 https://python.org 安装"
fi
print_success "Python 3 可用"

if ! command -v curl &> /dev/null && ! command -v wget &> /dev/null; then
    print_error "下载脚本需要 curl 或 wget。"
fi

# 第 2 步：选择模式
if [ -z "$MODE" ]; then
    if [ -t 0 ] || [ -e /dev/tty ]; then
        echo -e "${DIM}选择部署模式：${NC}"
        echo ""
        echo -e "  ${BOLD}1)${NC} 本地 ${DIM}- 在本机运行 Hindsight（默认）${NC}"
        echo -e "  ${BOLD}2)${NC} 云端 ${DIM}- 连接 Hindsight Cloud${NC}"
        echo ""
        if [ -t 0 ]; then
            read -p "输入选项 [1]：" mode_choice
        else
            read -p "输入选项 [1]：" mode_choice </dev/tty
        fi
        mode_choice=${mode_choice:-1}
        case $mode_choice in
            1) MODE="local" ;;
            2) MODE="cloud" ;;
            *) MODE="local" ;;
        esac
        echo ""
    else
        MODE="local"
    fi
fi

print_info "模式：${BOLD}$MODE${NC}"

# 第 3 步：从 GitHub 下载脚本
print_step "正在下载钩子脚本"

mkdir -p "${SCRIPTS_DIR}/lib"

download_file() {
    local url="$1"
    local dest="$2"
    if command -v curl &> /dev/null; then
        curl -fsSL "$url" -o "$dest"
    else
        wget -q "$url" -O "$dest"
    fi
}

for file in "${SCRIPT_FILES[@]}"; do
    download_file "${GITHUB_RAW}/${file}" "${SCRIPTS_DIR}/${file#scripts/}"
done

chmod +x "${SCRIPTS_DIR}/session_start.py"
chmod +x "${SCRIPTS_DIR}/recall.py"
chmod +x "${SCRIPTS_DIR}/retain.py"

print_success "脚本已安装到 ${SCRIPTS_DIR}"

# 第 4 步：下载默认设置（不覆盖已有设置，但更新版本）
SETTINGS_DST="${INSTALL_DIR}/settings.json"
if [ ! -f "${SETTINGS_DST}" ]; then
    download_file "${GITHUB_RAW}/settings.json" "${SETTINGS_DST}"
    print_success "默认设置已写入 ${SETTINGS_DST}"
else
    # 将上游版本和新增键合并到已有设置
    SETTINGS_TMP="${INSTALL_DIR}/settings.json.new"
    download_file "${GITHUB_RAW}/settings.json" "${SETTINGS_TMP}"
    if command -v python3 &> /dev/null; then
        python3 -c "
import json, sys
with open('${SETTINGS_DST}') as f:
    existing = json.load(f)
with open('${SETTINGS_TMP}') as f:
    upstream = json.load(f)
# 添加上游新增键（不覆盖用户自定义设置）
for key, value in upstream.items():
    if key not in existing:
        existing[key] = value
# 始终更新版本
existing['version'] = upstream.get('version', existing.get('version', ''))
with open('${SETTINGS_DST}', 'w') as f:
    json.dump(existing, f, indent=2)
    f.write('\n')
" 2>/dev/null && {
            rm -f "${SETTINGS_TMP}"
            NEW_VER=$(python3 -c "import json; print(json.load(open('${SETTINGS_DST}'))['version'])" 2>/dev/null)
            print_success "设置已更新（v${NEW_VER}），用户自定义设置已保留"
        } || {
            rm -f "${SETTINGS_TMP}"
            print_info "保留 ${SETTINGS_DST} 中的已有设置"
        }
    else
        rm -f "${SETTINGS_TMP}"
        print_info "保留 ${SETTINGS_DST} 中的已有设置"
    fi
fi

# 第 5 步：配置连接
if [ "$MODE" = "cloud" ]; then
    print_step "正在配置 Hindsight Cloud 连接"

    DEFAULT_CLOUD_URL="https://api.hindsight.vectorize.io"

    echo -e "${DIM}输入 Hindsight Cloud 连接信息。${NC}"
    echo -e "${DIM}可从 https://ui.hindsight.vectorize.io 获取这些信息${NC}"
    echo ""

    if [ -t 0 ]; then
        read -p "云端 API URL [$DEFAULT_CLOUD_URL]：" CLOUD_URL
        read -p "API 令牌：" CLOUD_TOKEN
    else
        read -p "云端 API URL [$DEFAULT_CLOUD_URL]：" CLOUD_URL </dev/tty
        read -p "API 令牌：" CLOUD_TOKEN </dev/tty
    fi
    CLOUD_URL=${CLOUD_URL:-$DEFAULT_CLOUD_URL}

    if [ -z "$CLOUD_TOKEN" ]; then
        print_error "云端模式需要 API 令牌"
    fi

    # 写入用户配置
    USER_CONFIG="${HOME}/.hindsight/codex.json"
    cat > "$USER_CONFIG" <<CFGEOF
{
  "hindsightApiUrl": "${CLOUD_URL}",
  "hindsightApiToken": "${CLOUD_TOKEN}"
}
CFGEOF
    chmod 600 "$USER_CONFIG"
    print_success "云端配置已保存到 ${USER_CONFIG}"

else
    # 本地模式：检查 LLM 提供商
    print_step "正在检查 LLM 配置"

    if [ -n "${OPENAI_API_KEY:-}" ]; then
        print_success "已检测到 OpenAI API 密钥"
    elif [ -n "${ANTHROPIC_API_KEY:-}" ]; then
        print_success "已检测到 Anthropic API 密钥"
    elif [ -n "${GEMINI_API_KEY:-}" ]; then
        print_success "已检测到 Gemini API 密钥"
    elif [ -n "${GROQ_API_KEY:-}" ]; then
        print_success "已检测到 Groq API 密钥"
    else
        print_warning "未检测到 LLM API 密钥。使用 Codex 前请设置一个密钥："
        echo -e "    ${CYAN}export OPENAI_API_KEY=sk-your-key${NC}"
        echo -e "    ${DIM}或${NC}"
        echo -e "    ${CYAN}export ANTHROPIC_API_KEY=your-key${NC}"
    fi
fi

# 第 6 步：写入 hooks.json
print_step "正在配置 Codex 钩子"

mkdir -p "${CODEX_DIR}"
cat > "${HOOKS_FILE}" <<HOOKSEOF
{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${SCRIPTS_DIR}/session_start.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${SCRIPTS_DIR}/recall.py\"",
            "timeout": 12
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${SCRIPTS_DIR}/retain.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
HOOKSEOF
print_success "钩子已写入 ${HOOKS_FILE}"

# 第 7 步：在 config.toml 中启用 codex_hooks
if [ ! -f "${CONFIG_FILE}" ]; then
    touch "${CONFIG_FILE}"
fi

if grep -q '^\[features\]' "${CONFIG_FILE}" 2>/dev/null; then
    if ! grep -q '^codex_hooks' "${CONFIG_FILE}"; then
        sed -i.bak '/^\[features\]/a codex_hooks = true' "${CONFIG_FILE}" && rm -f "${CONFIG_FILE}.bak"
        print_success "已向 ${CONFIG_FILE} 添加 codex_hooks = true"
    else
        print_info "codex_hooks 已启用"
    fi
else
    printf '\n[features]\ncodex_hooks = true\n' >> "${CONFIG_FILE}"
    print_success "已向 ${CONFIG_FILE} 添加 codex_hooks = true"
fi

# 完成！
echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}  ✓ 安装完成！${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo -e "  Hindsight 记忆功能已在 ${BOLD}Codex CLI${NC} 中启用。"
echo ""
echo -e "  ${DIM}配置：${NC}"
echo -e "    ${CYAN}~/.hindsight/codex/settings.json${NC}  ${DIM}（插件默认设置）${NC}"
echo -e "    ${CYAN}~/.hindsight/codex.json${NC}           ${DIM}（个人覆盖设置）${NC}"
echo ""
echo -e "  ${DIM}启动新的 Codex 会话以激活。${NC}"
echo ""
echo -e "  ${DIM}卸载：${NC}"
echo -e "    ${CYAN}curl -fsSL https://hindsight.vectorize.io/get-codex | bash -s -- --uninstall${NC}"
echo ""
echo -e "  ${DIM}文档：${NC} ${BLUE}https://hindsight.vectorize.io/sdks/integrations/codex${NC}"
echo ""
